# OKX API Secrets (USDC Futures / Hedge Mode) - R-SEC-01 Compliance
OKX_API_KEY=your_okx_api_key_here
OKX_SECRET=your_okx_secret_here
OKX_PASSPHRASE=your_okx_passphrase_here
OKX_IS_SANDBOX=false

# Environment & Trading Configuration
MMS4_LOG_LEVEL=INFO
MMS4_API_KEY=your_mms4_api_key_here
MMS4_SYMBOL_SPOT=BTC/USDT:USDT
MMS4_SYMBOL_FUTURES=BTC/USDT:USDT
# MMS4_SYMBOL przechowuje aktywny symbol (domyślnie biorąc MMS4_SYMBOL_FUTURES):
MMS4_SYMBOL=BTC/USDT:USDT
MMS4_TRADE_AMOUNT_USD=10.0
