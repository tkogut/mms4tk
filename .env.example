# OKX API Secrets (USDC Futures / Hedge Mode) - R-SEC-01 Compliance
OKX_API_KEY=your_okx_api_key_here
OKX_SECRET=your_okx_secret_here
OKX_PASSPHRASE=your_okx_passphrase_here
OKX_IS_SANDBOX=false

# Environment & Trading Configuration
MMS4_LOG_LEVEL=INFO
MMS4_API_KEY=your_mms4_api_key_here
MMS4_SYMBOL_SPOT=BTC/USDC
MMS4_SYMBOL_FUTURES=BTC/USDC
MMS4_SYMBOL=BTC/USDC
MMS4_MAX_MARGIN_USD=10.0
MMS4_TRADE_AMOUNT_USD=10.0

# ── Position sizing (all relational — nothing here hardcodes a cash limit) ──
# Split of MMS4_MAX_MARGIN_USD between the base entry and the high-risk add.
MMS4_BASE_ALLOCATION=0.70
MMS4_ADDON_ALLOCATION=0.30

# ── SCOUT_MODE risk reduction ──
# Risk is cut through SIZE, not leverage: OKX rejects leverage below 1x, so a sub-1x
# value would be clamped on the exchange while the notional it implied fell under the
# venue's minimum order value and the entry got skipped entirely.
#
#   scout_margin   = MMS4_MAX_MARGIN_USD * MMS4_BASE_ALLOCATION * MMS4_SCOUT_SIZE_MULT
#   scout_notional = scout_margin * MMS4_SCOUT_LEVERAGE
#
# Notional reduction vs BASE = base_leverage / (SCOUT_LEVERAGE * SCOUT_SIZE_MULT).
# At the defaults with MODERATE (x3): 3 / (1.0 * 0.3) = 10x, at ANY account size.
MMS4_SCOUT_LEVERAGE=1.0
MMS4_SCOUT_SIZE_MULT=0.3

# ── BASE_MODE leverage per risk profile ──
# Set MMS4_LEVERAGE_MODERATE=1.0 for the literal MMS v4 specification.
MMS4_LEVERAGE_CONSERVATIVE=1.0
MMS4_LEVERAGE_MODERATE=3.0
MMS4_LEVERAGE_AGGRESSIVE=10.0

# ── Exchange order minimum ──
# Read per-symbol from CCXT market limits. This value is only the fallback used when the
# venue publishes no limits for an instrument.
MMS4_MIN_NOTIONAL_USD=7.0

# ── Stop-loss distances (used for entries and for stop-out reconciliation) ──
MMS4_BASE_SL_PCT=0.02
MMS4_ADDON_SL_PCT=0.0125
