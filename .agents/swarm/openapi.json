{
  "openapi": "3.1.0",
  "info": {
    "title": "MMS4 Toolkit API (mms4tk)",
    "description": "Execution module & API interface for MMS v4 strategy managed by Hermes agent",
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Get Health",
        "description": "Health check endpoint.",
        "operationId": "get_health_api_v1_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/state": {
      "get": {
        "tags": [
          "State"
        ],
        "summary": "Get State",
        "description": "Get current MMS4 strategy state, active leverage, and equity metrics.",
        "operationId": "get_state_api_v1_state_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StateResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/stats/pnl": {
      "get": {
        "tags": [
          "Stats"
        ],
        "summary": "Get Pnl",
        "description": "Get daily ROE %, realized PnL, unrealized PnL, and trade stats.",
        "operationId": "get_pnl_api_v1_stats_pnl_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PnLResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/analytics/calculate": {
      "post": {
        "tags": [
          "Analytics"
        ],
        "summary": "Calculate Analytics",
        "description": "Accepts OHLCV candle list, returns calculated TMA, ATR, Bands, and evaluated SignalResult.",
        "operationId": "calculate_analytics_api_v1_analytics_calculate_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CalculateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CalculateResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/analytics/signals": {
      "get": {
        "tags": [
          "Analytics"
        ],
        "summary": "Get Latest Signal",
        "description": "Returns latest signal evaluated from state.",
        "operationId": "get_latest_signal_api_v1_analytics_signals_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignalResult"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/emergency/killall": {
      "post": {
        "tags": [
          "Emergency"
        ],
        "summary": "Emergency Killall",
        "description": "Emergency stop endpoint triggered by parent controller (Hermes).\nCancels all open orders, closes active positions, and locks execution.",
        "operationId": "emergency_killall_api_v1_emergency_killall_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmergencyKillallResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/emergency/reverse": {
      "post": {
        "tags": [
          "Emergency"
        ],
        "summary": "Emergency Reverse",
        "description": "Emergency position reversal triggered by Hermes agent.\nCloses current position immediately and opens opposite position with SL=2%.",
        "operationId": "emergency_reverse_api_v1_emergency_reverse_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmergencyReverseResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/trade/high_risk_add": {
      "post": {
        "tags": [
          "Trading"
        ],
        "summary": "High Risk Add",
        "description": "High-risk position add (leverage x1, independent ticket) with tight SL=1%.\nBlocked if strategy is in SCOUT_MODE (REDUCED_RISK).",
        "operationId": "high_risk_add_api_v1_trade_high_risk_add_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/HighRiskAddRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HighRiskAddResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CalculateRequest": {
        "properties": {
          "candles": {
            "items": {
              "$ref": "#/components/schemas/Candle"
            },
            "type": "array",
            "title": "Candles"
          },
          "params": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/IndicatorParams"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "candles"
        ],
        "title": "CalculateRequest"
      },
      "CalculateResponse": {
        "properties": {
          "tma": {
            "items": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": "array",
            "title": "Tma"
          },
          "atr": {
            "items": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": "array",
            "title": "Atr"
          },
          "upper_band": {
            "items": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": "array",
            "title": "Upper Band"
          },
          "lower_band": {
            "items": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": "array",
            "title": "Lower Band"
          },
          "signal": {
            "$ref": "#/components/schemas/SignalResult"
          }
        },
        "type": "object",
        "required": [
          "tma",
          "atr",
          "upper_band",
          "lower_band",
          "signal"
        ],
        "title": "CalculateResponse"
      },
      "Candle": {
        "properties": {
          "timestamp": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "string"
              },
              {
                "type": "string",
                "format": "date-time"
              }
            ],
            "title": "Timestamp"
          },
          "open": {
            "type": "number",
            "title": "Open"
          },
          "high": {
            "type": "number",
            "title": "High"
          },
          "low": {
            "type": "number",
            "title": "Low"
          },
          "close": {
            "type": "number",
            "title": "Close"
          },
          "volume": {
            "type": "number",
            "title": "Volume",
            "default": 0.0
          }
        },
        "type": "object",
        "required": [
          "timestamp",
          "open",
          "high",
          "low",
          "close"
        ],
        "title": "Candle",
        "description": "OHLCV candle representation."
      },
      "EmergencyKillallResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "action_taken": {
            "type": "string",
            "title": "Action Taken"
          }
        },
        "type": "object",
        "required": [
          "status",
          "message",
          "action_taken"
        ],
        "title": "EmergencyKillallResponse"
      },
      "EmergencyReverseResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "action_taken": {
            "type": "string",
            "title": "Action Taken"
          }
        },
        "type": "object",
        "required": [
          "status",
          "message",
          "action_taken"
        ],
        "title": "EmergencyReverseResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "version": {
            "type": "string",
            "title": "Version"
          }
        },
        "type": "object",
        "required": [
          "status",
          "version"
        ],
        "title": "HealthResponse"
      },
      "HighRiskAddRequest": {
        "properties": {
          "side": {
            "type": "string",
            "title": "Side",
            "description": "Order side: LONG or SHORT",
            "default": "LONG"
          },
          "size": {
            "type": "number",
            "title": "Size",
            "description": "Position size multiplier or contracts",
            "default": 1.0
          },
          "stop_loss_pct": {
            "type": "number",
            "title": "Stop Loss Pct",
            "description": "Tight stop loss percentage (e.g. 0.01 for 1%)",
            "default": 0.01
          }
        },
        "type": "object",
        "title": "HighRiskAddRequest"
      },
      "HighRiskAddResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "executed": {
            "type": "boolean",
            "title": "Executed"
          },
          "reason": {
            "type": "string",
            "title": "Reason"
          },
          "details": {
            "additionalProperties": true,
            "type": "object",
            "title": "Details"
          }
        },
        "type": "object",
        "required": [
          "status",
          "executed",
          "reason",
          "details"
        ],
        "title": "HighRiskAddResponse"
      },
      "IndicatorParams": {
        "properties": {
          "tma_length": {
            "type": "integer",
            "title": "Tma Length",
            "default": 20
          },
          "atr_period": {
            "type": "integer",
            "title": "Atr Period",
            "default": 14
          },
          "atr_mult": {
            "type": "number",
            "title": "Atr Mult",
            "default": 2.0
          }
        },
        "type": "object",
        "title": "IndicatorParams",
        "description": "Parameters for TMA and ATR calculation."
      },
      "PnLResponse": {
        "properties": {
          "daily_roe": {
            "type": "number",
            "title": "Daily Roe",
            "description": "Daily Return on Equity percentage"
          },
          "realized_pnl": {
            "type": "number",
            "title": "Realized Pnl",
            "description": "Realized Profit and Loss"
          },
          "unrealized_pnl": {
            "type": "number",
            "title": "Unrealized Pnl",
            "description": "Unrealized Profit and Loss"
          },
          "total_trades": {
            "type": "integer",
            "title": "Total Trades",
            "description": "Total number of trades executed"
          },
          "win_rate": {
            "type": "number",
            "title": "Win Rate",
            "description": "Win rate percentage (0.0 to 1.0)"
          }
        },
        "type": "object",
        "required": [
          "daily_roe",
          "realized_pnl",
          "unrealized_pnl",
          "total_trades",
          "win_rate"
        ],
        "title": "PnLResponse"
      },
      "SignalResult": {
        "properties": {
          "signal_type": {
            "type": "string",
            "title": "Signal Type"
          },
          "price": {
            "type": "number",
            "title": "Price"
          },
          "stop_loss": {
            "type": "number",
            "title": "Stop Loss"
          },
          "leverage": {
            "type": "number",
            "title": "Leverage"
          },
          "is_allowed": {
            "type": "boolean",
            "title": "Is Allowed",
            "default": true
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          }
        },
        "type": "object",
        "required": [
          "signal_type",
          "price",
          "stop_loss",
          "leverage"
        ],
        "title": "SignalResult",
        "description": "Result of MMS4 signal evaluation.\nsignal_type: \"NONE\" | \"BASE_LONG\" | \"BASE_SHORT\" | \"HIGH_RISK_ADD_LONG\" | \"HIGH_RISK_ADD_SHORT\""
      },
      "StateResponse": {
        "properties": {
          "state": {
            "type": "string",
            "title": "State"
          },
          "leverage": {
            "type": "number",
            "title": "Leverage"
          },
          "current_equity": {
            "type": "number",
            "title": "Current Equity"
          },
          "realized_pnl": {
            "type": "number",
            "title": "Realized Pnl"
          },
          "total_trades": {
            "type": "integer",
            "title": "Total Trades"
          }
        },
        "type": "object",
        "required": [
          "state",
          "leverage",
          "current_equity",
          "realized_pnl",
          "total_trades"
        ],
        "title": "StateResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}