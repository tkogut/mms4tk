{
  "openapi": "3.1.0",
  "info": {
    "title": "MMS4TK OpenAPI Schema for Hermes Agent",
    "version": "0.3.0"
  },
  "tools": [
    {
      "type": "function",
      "function": {
        "name": "get_state",
        "description": "Fetch current MMS4 strategy state, active leverage, equity, and trade counters.",
        "parameters": {
          "type": "object",
          "properties": {},
          "required": []
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "get_balance",
        "description": "Fetch unified OKX account balances (free available and total funds per currency) via mms4tk.",
        "parameters": {
          "type": "object",
          "properties": {},
          "required": []
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "get_pnl",
        "description": "Fetch daily ROE %, realized PnL, unrealized PnL, and trade performance statistics.",
        "parameters": {
          "type": "object",
          "properties": {},
          "required": []
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "calculate_analytics",
        "description": "Calculate TMA, ATR, envelope bands, and evaluate trading signals from OHLCV candles.",
        "parameters": {
          "type": "object",
          "properties": {
            "candles": {
              "type": "array",
              "description": "List of OHLCV candle objects",
              "items": {
                "type": "object",
                "properties": {
                  "timestamp": {
                    "type": "number"
                  },
                  "open": {
                    "type": "number"
                  },
                  "high": {
                    "type": "number"
                  },
                  "low": {
                    "type": "number"
                  },
                  "close": {
                    "type": "number"
                  },
                  "volume": {
                    "type": "number"
                  }
                },
                "required": [
                  "timestamp",
                  "open",
                  "high",
                  "low",
                  "close",
                  "volume"
                ]
              }
            },
            "params": {
              "type": "object",
              "description": "Optional indicator parameters",
              "properties": {
                "tma_length": {
                  "type": "integer",
                  "default": 20
                },
                "atr_period": {
                  "type": "integer",
                  "default": 14
                },
                "atr_mult": {
                  "type": "number",
                  "default": 2.0
                }
              }
            }
          },
          "required": [
            "candles"
          ]
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "emergency_killall",
        "description": "Emergency stop signal: cancels all open orders and closes active positions immediately. Requires X-MMS4-API-KEY header.",
        "parameters": {
          "type": "object",
          "properties": {
            "x_mms4_api_key": {
              "type": "string",
              "description": "Authentication key for X-MMS4-API-KEY header."
            }
          },
          "required": []
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "emergency_reverse",
        "description": "Emergency position reversal: closes current position and opens opposite position with SL=2%. Requires X-MMS4-API-KEY header.",
        "parameters": {
          "type": "object",
          "properties": {
            "x_mms4_api_key": {
              "type": "string",
              "description": "Authentication key for X-MMS4-API-KEY header."
            }
          },
          "required": []
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "high_risk_add",
        "description": "Force high-risk position addition (leverage x1, tight SL=1%). Blocked in SCOUT_MODE. Requires X-MMS4-API-KEY header.",
        "parameters": {
          "type": "object",
          "properties": {
            "side": {
              "type": "string",
              "enum": [
                "LONG",
                "SHORT"
              ],
              "default": "LONG",
              "description": "Direction of position add"
            },
            "size": {
              "type": "number",
              "default": 1.0,
              "description": "Size or contracts for addition"
            },
            "stop_loss_pct": {
              "type": "number",
              "default": 0.01,
              "description": "Tight stop loss percentage (e.g. 0.01)"
            },
            "x_mms4_api_key": {
              "type": "string",
              "description": "Authentication key for X-MMS4-API-KEY header."
            }
          },
          "required": []
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "mms4_get_positions",
        "description": "Fetch all live open trading positions from OKX across active trading symbols (side, contracts, entry price, mark price, notional USD, unrealized PnL).",
        "parameters": {
          "type": "object",
          "properties": {},
          "required": []
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "mms4_get_symbols",
        "description": "Fetch all configured trading symbols with active status, per-symbol USD allocation, Base/Add ratio, live OKX price, state, and leverage.",
        "parameters": {
          "type": "object",
          "properties": {},
          "required": []
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "mms4_get_higher_tf",
        "description": "Fetch higher timeframe (H4/D1) analytics including D1 ATR expansion ratio, H4 TMA position, and candle formation.",
        "parameters": {
          "type": "object",
          "properties": {},
          "required": []
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "mms4_set_strategy_profile",
        "description": "Update active strategy profile (directional_bias, risk_profile, scout_override, reason) for adaptive autotrading. Requires X-MMS4-API-KEY header.",
        "parameters": {
          "type": "object",
          "properties": {
            "directional_bias": {
              "type": "string",
              "enum": [
                "BOTH",
                "LONG_ONLY",
                "SHORT_ONLY",
                "FLAT"
              ],
              "default": "BOTH",
              "description": "Directional bias filtering"
            },
            "risk_profile": {
              "type": "string",
              "enum": [
                "CONSERVATIVE",
                "MODERATE",
                "AGGRESSIVE"
              ],
              "default": "MODERATE",
              "description": "Risk profile modulating leverage"
            },
            "scout_override": {
              "type": "boolean",
              "default": false,
              "description": "Set True to allow early SCOUT_MODE relaxation"
            },
            "reason": {
              "type": "string",
              "default": "",
              "description": "Reason for profile update"
            },
            "x_mms4_api_key": {
              "type": "string",
              "description": "Authentication key for X-MMS4-API-KEY header."
            }
          },
          "required": []
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "mms4_get_pending_events",
        "description": "Fetch pending webhook events from mms4tk that need to be dispatched to Hermes Kanban. Returns a list of undispatched SCOUT_MODE events.",
        "parameters": {
          "type": "object",
          "properties": {},
          "required": []
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "mms4_hitl_resolve",
        "description": "Human-in-the-Loop resolution for uncertain H4 candle classification. Decision: SWEEP_WICK (relax SCOUT_MODE) or MARUBOZU_BREAKOUT (maintain SCOUT_MODE). Requires X-MMS4-API-KEY header.",
        "parameters": {
          "type": "object",
          "properties": {
            "decision": {
              "type": "string",
              "enum": [
                "SWEEP_WICK",
                "MARUBOZU_BREAKOUT"
              ],
              "description": "H4 candle classification decision"
            },
            "directional_bias": {
              "type": "string",
              "enum": [
                "BOTH",
                "LONG_ONLY",
                "SHORT_ONLY",
                "FLAT"
              ],
              "default": "BOTH",
              "description": "Directional bias to apply"
            },
            "risk_profile": {
              "type": "string",
              "enum": [
                "CONSERVATIVE",
                "MODERATE",
                "AGGRESSIVE"
              ],
              "default": "MODERATE",
              "description": "Risk profile to apply"
            },
            "reason": {
              "type": "string",
              "default": "Human-in-the-Loop decision",
              "description": "Reason for the decision"
            },
            "x_mms4_api_key": {
              "type": "string",
              "description": "Authentication key for X-MMS4-API-KEY header."
            }
          },
          "required": [
            "decision"
          ]
        }
      }
    }
  ]
}